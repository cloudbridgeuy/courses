# Local dev configuration consumed by `cargo xtask dev`. Copy to .env (gitignored).

# Server
PORT=8090

# Apps gating: leave CB_APPS_SECRET unset to run open, or set it to require ?secret=
# CB_APPS_SECRET=lab-secret
# CB_APPS_GATED=all            # or a comma list of kinds: cpu-burst,counter,metric,toast-demo
CB_APPS_TABLE=courses-apps
CB_APPS_PUBLIC_COLLECTIONS=counters

# AWS region for DynamoDB Local (endpoint + dummy creds are injected by xtask dev)
AWS_REGION=us-east-1
# Note: the API metric path (PutMetricData) requires real AWS credentials and does
# not work against DynamoDB Local. The EMF metric path works locally because it only
# writes a structured log line to stdout — no AWS API call is made.
